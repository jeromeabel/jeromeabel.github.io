---
import SeriePostListItem from "@components/blog/SeriePostListItem.astro";
import H1 from "@components/ui/H1.astro";
import Link from "@components/ui/Link.astro";
import P from "@components/ui/P.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getPostsFromSerie, getSerieStats } from "src/utils/repository";

export async function getStaticPaths() {
  const series = await getCollection("serie");
  return series.map((entry) => ({
    params: { serie: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

if (!entry) {
  throw new Error("Sorry, could not find serie");
}

const publishedDate = entry.data.date;
const posts = await getPostsFromSerie(entry);
const { parts, minutes } = await getSerieStats(entry);
const readLabel =
  minutes >= 60
    ? `~${Math.floor(minutes / 60)}h ${minutes % 60}m read`
    : `${minutes} min read`;
---

<Layout
  page={entry.data.title}
  description={entry.data.description}
  {publishedDate}
>
  <main
    class="py-section lg:py-section-lg container flex flex-col gap-8 lg:gap-12"
  >
    <header class="flex w-full flex-col gap-4 lg:w-2/3 lg:gap-8">
      <div>
        <nav
          class="text-foreground-muted mb-2 flex items-center gap-1 uppercase"
        >
          <Link href="/blog" label="BLOG" variant="menuInactive" />
          <Icon name="lucide:chevron-right" />
        </nav>
        <div class="flex items-center gap-3">
          <Icon name="lucide:folder" class="text-foreground-muted text-2xl" />
          <H1>{entry.data.title}</H1>
        </div>
      </div>

      <P>
        {entry.data.abstract}
      </P>

      <div class="text-foreground-muted flex items-center gap-2">
        <Icon name="lucide:layers" />
        <span class="text-sm">{parts} parts</span>
        <Icon name="lucide:clock" class="ms-6" />
        <span class="text-sm">{readLabel}</span>
      </div>
    </header>

    <div class="border-border border-t">
      {posts.map((post, index) => <SeriePostListItem {post} {index} />)}
    </div>
  </main>
</Layout>
