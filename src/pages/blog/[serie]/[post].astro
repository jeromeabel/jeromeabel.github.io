---
import SerieContents from "@components/blog/SerieContents.astro";
import TableOfContents from "@components/blog/TableOfContents.astro";
import TopicChips from "@components/blog/TopicChips.astro";
import CustomImage from "@components/ui/CustomImage.astro";
import H1 from "@components/ui/H1.astro";
import Link from "@components/ui/Link.astro";
import LinkNavPost from "@components/ui/LinkNavPost.astro";
import P from "@components/ui/P.astro";
import Prose from "@components/ui/Prose.astro";
import SocialShare from "@components/ui/SocialShare.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection, getEntry, render } from "astro:content";
import { getFormattedDate } from "src/utils/format-date";
import { getPostsFromSerie } from "src/utils/repository";

export async function getStaticPaths() {
  const series = await getCollection("serie");
  return series.flatMap((serie) => {
    return serie.data.posts.map((post, i) => {
      const postId = post.id.split("/").pop();
      return {
        params: { serie: serie.id, post: postId },
        props: { index: i },
      };
    });
  });
}

const { serie, post } = Astro.params;
const { index } = Astro.props;

if (!serie) {
  throw new Error("Sorry, could not find serie");
}

const currentPost = await getEntry("seriePost", `${serie}/${post}`);
const currentSerie = await getEntry("serie", serie);

if (!currentSerie) {
  throw new Error("Sorry, could not find serie");
}

const currentPosts = await getPostsFromSerie(currentSerie);
const numberOfPosts = currentPosts.length;
const prevPost = index === 0 ? null : currentPosts[index - 1];
const nextPost = index + 1 === numberOfPosts ? null : currentPosts[index + 1];

if (!currentPost) {
  throw new Error("Sorry, could not find serie");
}
const { Content, headings, remarkPluginFrontmatter } =
  await render(currentPost);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 4;
const minutesRead =
  (currentPost.data as { minutesRead?: string }).minutesRead ??
  remarkPluginFrontmatter.minutesRead;
const publishedDate = new Date(currentPost.data.date);

const hasPagination = nextPost !== null || prevPost !== null;

const canonicalWebsiteURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<Layout
  page={currentPost.data.title}
  description={currentPost.data.description}
  {publishedDate}
  updatedDate={currentPost.data.updated}
  topic={currentPost.data.topic}
  type="article"
  image={currentPost.data.img}
>
  <main class="container flex flex-col gap-8 py-section lg:gap-12 lg:py-section-lg">
    <header
      class="border-border flex w-full flex-col gap-4 border-b pb-6 lg:w-2/3 lg:gap-8 lg:pb-12"
    >
      <div>
        <nav
          class="text-foreground-muted mb-4 flex flex-col gap-1 uppercase md:flex-row"
        >
          <div class="flex items-center gap-1">
            <Link href="/blog" label="Blog" variant="menuInactive" />
            <Icon name="lucide:chevron-right" />
          </div>
          <div class="flex items-center gap-1">
            <Link
              href=`/blog/${currentSerie.id}`
              label=`${currentSerie.data.title}`
              variant="menuInactive"
            />
            <Icon name="lucide:chevron-right" />
            Part {index + 1} of {numberOfPosts}
          </div>
        </nav>
        <H1>{currentPost.data.title}</H1>
      </div>
      <P>{currentPost.data.abstract}</P>

      <div
        class="mt-4 flex flex-col justify-between gap-4 sm:flex-row md:items-center md:gap-2"
      >
        <div class="text-foreground-muted flex items-center gap-2 md:mt-4">
          <Icon name="lucide:calendar" />
          <time class="text-sm">{getFormattedDate(currentPost.data.date)}</time>
          {
            currentPost.data.updated && (
              <span class="text-sm">
                · Updated {getFormattedDate(currentPost.data.updated)}
              </span>
            )
          }
          <Icon name="lucide:clock" class="ms-4 lg:ms-6" />
          <span class="text-sm">{minutesRead}</span>
        </div>
        <TopicChips topic={currentPost.data.topic} />

        <SocialShare
          url={canonicalWebsiteURL}
          title={currentPost.data.title}
          description={currentPost.data.description}
        />
      </div>
    </header>

    {
      currentPost.data.img && (
        <CustomImage img={currentPost.data.img} alt={currentPost.data.title} />
      )
    }

    {
      showToc && (
        <details class="border-border rounded-lg border p-4 md:hidden">
          <summary class="text-foreground-muted cursor-pointer text-sm font-medium uppercase">
            On this page
          </summary>
          <div class="mt-3">
            <TableOfContents headings={tocHeadings} showLabel={false} />
          </div>
        </details>
      )
    }

    <div class="mt-4 flex items-start gap-12 md:mt-8">
      <Prose class="min-w-0 flex-1 md:mx-auto" data-expand-image="inline">
        <Content />
      </Prose>
      {
        showToc && (
          <aside class="sticky top-24 hidden max-h-[calc(100vh-8rem)] w-56 shrink-0 overflow-y-auto md:block">
            <TableOfContents headings={tocHeadings} />
          </aside>
        )
      }
    </div>

    <SerieContents
      serieTitle={currentSerie.data.title}
      posts={currentPosts}
      currentId={currentPost.id}
    />

    {
      hasPagination && (
        <div class="container mt-16 flex justify-between gap-2 md:gap-8">
          {prevPost && (
            <LinkNavPost
              type="prev"
              title={prevPost.data.title}
              id={prevPost.id}
            />
          )}

          {!prevPost && (
            <LinkNavPost
              type="prev"
              title={currentSerie.data.title}
              id={currentSerie.id}
            />
          )}

          {nextPost && (
            <LinkNavPost
              type="next"
              title={nextPost.data.title}
              id={nextPost.id}
            />
          )}

          {!nextPost && (
            <LinkNavPost
              type="next"
              title={`Back to ${currentSerie.data.title}`}
              id={currentSerie.id}
            />
          )}
        </div>
      )
    }
  </main>
</Layout>
