---
import CustomImage from "@components/ui/CustomImage.astro";
import Link from "@components/ui/Link.astro";
import Prose from "@components/ui/Prose.astro";
import RelatedWriting from "@components/work/RelatedWriting.astro";
import WorkHeader from "@components/work/WorkHeader.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection, getEntries, render } from "astro:content";
import { getArchiveWorks, getFeaturedWorks } from "src/utils/repository";

export async function getStaticPaths() {
  const works = await getCollection("work");
  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const publishedDate = new Date(work.data.date);

const orderedWorks = [
  ...(await getFeaturedWorks()),
  ...(await getArchiveWorks()),
];
const index = orderedWorks.findIndex((entry) => entry.id === work.id);
const nextWork =
  index >= 0 && index < orderedWorks.length - 1
    ? orderedWorks[index + 1]
    : null;

const relatedPosts = work.data.related_posts
  ? await getEntries(work.data.related_posts)
  : [];
---

<Layout
  page={work.data.title}
  description={work.data.description}
  {publishedDate}
  image={work.data.img_social || work.data.img}
>
  <main class="min-w-screen">
    <div class="container flex flex-col gap-8 py-8 lg:gap-12 lg:py-24">
      <WorkHeader data={work.data} />
      <CustomImage img={work.data.img} alt={work.data.title} />
    </div>
    <Prose class="md:mx-auto" data-expand-image="inline">
      <Content />
    </Prose>
    {
      relatedPosts.length > 0 && (
        <div class="container mt-12 lg:mt-16">
          <RelatedWriting posts={relatedPosts} />
        </div>
      )
    }
    <div class="container mt-8 flex flex-col gap-4 sm:flex-row lg:mt-12">
      <Link
        label="All work"
        href="/work"
        icon="lucide:arrow-right"
        variant="secondary"
      />
      {
        nextWork && (
          <Link
            label={`Next: ${nextWork.data.title}`}
            href={`/work/${nextWork.id}`}
            icon="lucide:arrow-right"
            variant="secondary"
          />
        )
      }
    </div>
  </main>
</Layout>
