---
import Link from "@components/ui/Link.astro";

const today = new Date();

const siteLinks = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
];

const links = [
  { label: "GitHub", href: "https://github.com/jeromeabel" },
  { label: "Art Portfolio", href: "https://jeromeabel.net" },
  { label: "Bluesky", href: "https://bsky.app/profile/jeromeabel.bsky.social" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/jerome-abel/" },
  { label: "Email", href: "mailto:dev@jeromeabel.net" },
  { label: "RSS", href: "/rss.xml" },
];
---

<footer class="text-foreground-muted py-8 md:py-16">
  <div
    class="container flex flex-col-reverse justify-between gap-6 md:flex-row md:gap-8"
  >
    <div class="flex flex-wrap justify-center gap-1">
      <p class="text-center">Jérôme Abel - {today.getFullYear()} -</p>
      <Link
        href="https://creativecommons.org/licenses/by/4.0/"
        label="License CC BY 4.0"
      />
    </div>
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:gap-8">
      <ul class="flex flex-row flex-wrap justify-center gap-2 md:gap-6">
        {
          siteLinks.map((link) => (
            <li>
              <Link label={link.label} href={link.href} />
            </li>
          ))
        }
      </ul>
      <ul class="flex flex-row flex-wrap justify-center gap-2 md:gap-6">
        {
          links.map((link) => (
            <li>
              <Link label={link.label} href={link.href} />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
