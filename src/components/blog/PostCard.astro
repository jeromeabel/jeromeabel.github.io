---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { getFormattedDate } from "src/utils/format-date";
import { getMinutesReadFromBody } from "src/utils/get-minutes-read";

interface Props {
  post: CollectionEntry<"post">;
}

const { post } = Astro.props;

if (!post) {
  throw new Error("Sorry, could not find post");
}

const minutesRead = getMinutesReadFromBody(post.body);
---

{
  /* LEGACY — main-only, not wired into any v3 page. Kept for styleguide delete-vs-adopt review. See .specs/01_active/dev-styleguide. */
}
<a
  href=`/blog/${post.id}`
  class="border-border hover:bg-surface/50 flex flex-col gap-2 border p-4 lg:p-6"
>
  <h2 class="text-xl font-bold tracking-wide lg:text-2xl">
    {post.data.title}
  </h2>
  <p class="line-clamp-2">{post.data.description}</p>
  <div
    class="text-foreground-muted mt-auto flex items-center justify-end gap-2"
  >
    <Icon name="lucide:calendar" />
    <time class="text-sm">{getFormattedDate(post.data.date)}</time>
    {
      minutesRead && (
        <>
          <Icon name="lucide:clock" class="ms-6" />
          <span class="text-sm">{minutesRead}</span>
        </>
      )
    }
  </div>
</a>
