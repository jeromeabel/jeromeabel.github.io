---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { getMonthYear } from "src/utils/format-date";
import { getMinutesFromBody } from "src/utils/get-minutes-read";

interface Props {
  post: CollectionEntry<"post"> | CollectionEntry<"seriePost">;
  serie?: { title: string; id: string; part: number } | undefined;
}

const { post, serie } = Astro.props;

if (!post) {
  throw new Error("Sorry, could not find post");
}

const minutes = Math.ceil(getMinutesFromBody(post.body));
---

<a
  href={`/blog/${post.id}`}
  class="border-border hover:bg-surface group relative flex flex-col gap-1 overflow-hidden border-b py-4"
>
  <Icon
    name="lucide:arrow-right"
    class="text-foreground-muted absolute top-1/2 -translate-x-8 -translate-y-1/2 transition-transform group-hover:translate-x-2"
  />
  <div
    class="flex flex-col gap-1 transition-transform group-hover:translate-x-8"
  >
    {
      serie && (
        <span class="text-foreground-muted flex items-center gap-2 font-mono text-xs uppercase">
          <Icon name="lucide:folder" />
          {serie.title} · part {serie.part}
        </span>
      )
    }
    <div class="flex items-baseline justify-between gap-8">
      <h3 class="flex-1 font-bold">{post.data.title}</h3>
      <span class="text-foreground-muted shrink-0 font-mono text-xs">
        {minutes} min · {getMonthYear(post.data.date)}
      </span>
    </div>
  </div>
</a>
