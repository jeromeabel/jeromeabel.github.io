---
interface Props {
  topic?: string | undefined;
}

const { topic } = Astro.props;

const topics = (topic ?? "")
  .split(",")
  .map((t) => t.trim())
  .filter(Boolean);
---

{
  topics.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {topics.map((t) => (
        <span class="border-border text-foreground-muted border px-2 py-0.5 font-mono text-xs">
          {t}
        </span>
      ))}
    </div>
  )
}
