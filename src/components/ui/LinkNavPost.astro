---
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
  title: string;
  type: "prev" | "next";
}

const { id, title, type } = Astro.props;

if (!id) return;

const isNext = type === "next";
const iconName = isNext ? "lucide:arrow-right" : "lucide:arrow-left";
const positionType = isNext ? "text-right" : "text-left";
const paddingType = isNext ? "justify-end" : "justify-start";
const typeName = isNext ? "Next" : "Previous";
---

<a
  href=`/blog/${id}`
  data-type={type}
  class=`border-border hover:bg-surface flex w-1/2 items-center gap-3 border p-3 lg:px-4 lg:py-6 text-base md:text-xl ${paddingType}`
>
  {
    !isNext && (
      <Icon name={iconName} class="text-foreground-muted text-xl sm:text-2xl" />
    )
  }
  <div class=`${positionType}`>
    <p class="text-foreground-muted">{typeName}</p>
    <p class="text-xl md:text-2xl">{title}</p>
  </div>
  {
    isNext && (
      <Icon name={iconName} class="text-foreground-muted text-xl sm:text-2xl" />
    )
  }
</a>
