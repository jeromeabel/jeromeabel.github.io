---
import Link from "@components/ui/Link.astro";
---

<section class="reveal reveal-bottom container flex flex-col gap-6 lg:gap-8">
  <p
    class="font-title text-2xl tracking-wide text-balance sm:text-3xl lg:w-2/3"
  >
    Front-end engineer, writing about performance, testing, and AI workflows.
    <span class="text-muted"
      >I used to build robot drummers. Ask me sometime.</span
    >
  </p>
  <Link
    label="More about me"
    href="/about"
    icon="lucide:arrow-right"
    variant="secondary"
  />
</section>
