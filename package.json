{
  "name": "jeromeabel.github.io",
  "type": "module",
  "version": "3.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "pixel-check": "node scripts/pixel-check.mjs",
    "illustrate": "node images/scripts/illustrate.mjs",
    "illustrate:sheet": "node images/scripts/illustrate.mjs --sheet",
    "studio": "node images/scripts/studio.mjs",
    "crop": "node images/scripts/studio.mjs",
    "test": "node --test scripts/figma/**/*.test.mjs",
    "figma:primitives": "node scripts/figma/build-primitives.mjs primitives.json",
    "figma:verify": "node scripts/figma/extract-code-tokens.mjs tokens.code.json && node scripts/figma/diff-tokens.mjs tokens.code.json tokens.figma.json scripts/figma/token-map.json",
    "figma:verify-raw": "node scripts/figma/diff-raw-values.mjs raw-values.figma.json scripts/figma/named-debt.json",
    "geometry:web": "node scripts/figma/extract-web-geometry.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/netlify": "^8.1.2",
